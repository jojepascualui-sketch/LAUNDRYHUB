<?xml version="1.0" encoding="UTF-8"?>
<!-- A1-admin-dashboard. -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.laundryhub.admin.ui.DashboardController" spacing="22">
    <GridPane hgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <VBox styleClass="kpi-card" GridPane.columnIndex="0">
            <Label text="Orders today" styleClass="kpi-label"/>
            <Label fx:id="ordersToday" styleClass="figure"/>
        </VBox>
        <VBox styleClass="kpi-card" GridPane.columnIndex="1">
            <Label text="Waiting to process" styleClass="kpi-label"/>
            <Label fx:id="waiting" styleClass="figure"/>
        </VBox>
        <VBox styleClass="kpi-card" GridPane.columnIndex="2">
            <Label text="Kilos in today" styleClass="kpi-label"/>
            <Label fx:id="kilos" styleClass="figure"/>
        </VBox>
        <VBox styleClass="kpi-card, accent" GridPane.columnIndex="3">
            <Label text="Sales today" styleClass="kpi-label"/>
            <Label fx:id="sales" styleClass="figure"/>
        </VBox>
    </GridPane>

    <VBox styleClass="card" spacing="14">
        <Label text="Order pipeline" styleClass="section-title"/>
        <GridPane fx:id="pipeline" hgap="10"/>
    </VBox>

    <VBox styleClass="card" spacing="12">
        <HBox alignment="CENTER_LEFT">
            <Label text="Recent orders" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="View all" onAction="#viewAll" styleClass="link-button"/>
        </HBox>
        <GridPane fx:id="recent"/>
    </VBox>
</VBox>
