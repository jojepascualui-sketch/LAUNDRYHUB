<?xml version="1.0" encoding="utf-8"?>
<!-- Feedback (no design, CLAUDE.md §7): ratings card, then conversations list + detail like A2. -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.laundryhub.admin.ui.FeedbackController" spacing="16">
    <HBox styleClass="card, card-22" spacing="28" alignment="TOP_LEFT">
        <VBox minWidth="180">
            <Label text="Average rating" styleClass="kpi-label"/>
            <Label fx:id="average" styleClass="figure"/>
            <Label fx:id="ratingCount" styleClass="small"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Latest ratings" styleClass="section-title"/>
            <GridPane fx:id="ratingTable"/>
        </VBox>
    </HBox>

    <HBox spacing="16" alignment="TOP_LEFT">
        <VBox fx:id="threadList" spacing="10" minWidth="280" prefWidth="280" maxWidth="280"/>
        <VBox fx:id="detail" styleClass="card, card-22" spacing="14" HBox.hgrow="ALWAYS">
            <Label fx:id="threadName" styleClass="section-title"/>
            <ScrollPane fx:id="messageScroll" styleClass="page-scroll, chat-scroll" fitToWidth="true" hbarPolicy="NEVER"
                        prefHeight="380">
                <VBox fx:id="messages" spacing="10"/>
            </ScrollPane>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="replyField" promptText="Reply as Laundry HUB" styleClass="text-input-field"
                           HBox.hgrow="ALWAYS" accessibleText="Reply"/>
                <Button fx:id="send" text="Send" styleClass="primary-button, add-button"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
