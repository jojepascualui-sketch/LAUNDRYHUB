<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.laundryhub</groupId>
    <artifactId>laundryhub-admin</artifactId>
    <version>0.1.0</version>
    <name>LaundryHub Admin Console</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- JavaFX 21 is the LTS line that still runs on JDK 17 (25+ needs JDK 23). -->
        <javafx.version>21.0.12</javafx.version>
        <junit.version>5.13.4</junit.version>
        <jackson.version>2.18.2</jackson.version>
        <main.class>com.laundryhub.admin.AdminApp</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- A2 "Pinned location": Google Maps JavaScript API in a WebView. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- JSON for the REST API (records supported). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <executions>
                    <!-- HttpAdminApiTest serves fake API responses with the JDK's built-in HTTP server. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>com.laundryhub.admin=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!-- JDK 17 reads surefire's module-path @argfile in the Windows code page,
                         which breaks on the non-ASCII project path ("문서"). Test on the classpath. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
                <executions>
                    <!-- mvnw javafx:run@debug  ->  waits for VS Code to attach on port 5005 -->
                    <execution>
                        <id>debug</id>
                        <configuration>
                            <options>
                                <option>-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Windows: java.exe reads its arguments and @argfiles in the ANSI code page, so a forked
             JVM (javafx:run, spring-boot:run, VS Code launches) cannot load classes from a
             non-ASCII repo path such as OneDrive\<Korean folder>. Build outside the repo instead. -->
        <profile>
            <id>ascii-build-dir</id>
            <activation>
                <os><family>windows</family></os>
                <!-- Not inside VS Code's Java extension (m2e): it can only compile inside the project. -->
                <property><name>!m2e.version</name></property>
            </activation>
            <build>
                <directory>${user.home}/.laundryhub-build/${project.artifactId}</directory>
            </build>
        </profile>
    </profiles>
</project>
