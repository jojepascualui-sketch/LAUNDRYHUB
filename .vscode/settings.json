{
    // Java language server: import only the Maven projects. The Android project
    // is built with gradlew; the Java extension cannot import AGP projects.
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/android-app/**"
    ],
    "java.import.gradle.enabled": false,
    "java.import.maven.enabled": true,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "disabled",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-17",
            "path": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot",
            "default": true
        }
    ],
    "maven.executable.preferMavenWrapper": true,
    "java.debug.settings.hotCodeReplace": "auto",

    // Integrated terminals get the Android SDK and adb on PATH.
    "terminal.integrated.env.windows": {
        "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot",
        "PATH": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot\\bin;${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}",
        "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk"
    },

    "files.exclude": {
        "**/target": true,
        "**/build": true,
        "**/.gradle": true
    },
    "files.eol": "\n",
    "[bat]": { "files.eol": "\r\n" },
    "[cmd]": { "files.eol": "\r\n" },
    "files.associations": {
        "*.fxml": "xml"
    }
}
