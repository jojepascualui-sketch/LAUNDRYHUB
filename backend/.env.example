# Copy to backend/.env (git-ignored) and fill in. Real environment variables override this file.
DB_URL=jdbc:mysql://localhost:3306/laundryhub?createDatabaseIfNotExist=true&serverTimezone=Asia/Manila
DB_USER=laundryhub
DB_PASSWORD=
# BCrypt-hashed into the first admin account (admin@laundryhub.ph) on first start. At least 8 characters.
ADMIN_DEFAULT_PASSWORD=
# HS256 key for sign-in tokens, at least 32 characters. Blank = random per start (tokens die on restart).
LAUNDRYHUB_JWT_SECRET=
# OAuth client id used by "Continue with Google" in the Android app. Blank = Google sign-in disabled.
GOOGLE_OAUTH_CLIENT_ID=
# Server key with the Geocoding API enabled (fills the address from the pin). Blank = no geocoding.
GOOGLE_SERVER_KEY=
# Shop position for the delivery radius. Blank = use the position saved in shop_settings.
SHOP_LAT=
SHOP_LNG=

# ----- Optional: uncomment to change (an empty value would override the default) -----
# Time zone for "today" (orders today, slots). [Asia/Manila] Set it as a real environment variable:
# it is read before Spring loads this file.
# SHOP_TIME_ZONE=Asia/Manila
# Sign-in token lifetime in hours. [12]
# LAUNDRYHUB_TOKEN_HOURS=12
# E-mail of the first admin account created on first start. [admin@laundryhub.ph]
# ADMIN_DEFAULT_EMAIL=admin@laundryhub.ph
# HTTP port. [8080]
# PORT=8080
# Set to classpath:db/migration to start without the A1–A5 sample orders. [migration + sample-data]
# FLYWAY_LOCATIONS=classpath:db/migration
