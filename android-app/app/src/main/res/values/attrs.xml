<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ui.widget.SegmentedControl -->
    <declare-styleable name="SegmentedControl">
        <!-- Segment labels, e.g. @array/sign_in_tabs. -->
        <attr name="segments" format="reference" />
        <attr name="selectedIndex" format="integer" />
    </declare-styleable>

    <!-- ui.widget.FormField: label + TextInput + error line. -->
    <declare-styleable name="FormField">
        <attr name="label" format="string" />
        <attr name="android:hint" />
        <attr name="android:inputType" />
        <attr name="android:imeOptions" />
        <attr name="android:autofillHints" />
        <!-- 48 dp / 14 sp input, as on 04a and 05 (sign-in inputs are 51 dp / 15 sp). -->
        <attr name="compact" format="boolean" />
    </declare-styleable>
</resources>
