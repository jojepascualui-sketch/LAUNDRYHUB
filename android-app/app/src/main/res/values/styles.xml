    <style name="Widget.LaundryHub.CounterTile" parent="">
        <item name="android:background">@drawable/bg_counter_tile</item>
        <item name="android:paddingStart">@dimen/counter_padding_h</item>
        <item name="android:paddingEnd">@dimen/counter_padding_h</item>
        <item name="android:paddingTop">@dimen/counter_padding_v</item>
        <item name="android:paddingBottom">@dimen/counter_padding_bottom</item>
