<?xml version="1.0" encoding="utf-8"?>
<!--
    Laundry HUB design system (docs/design/DESIGN_SPEC.md section 1).
    Every screen uses these styles; do not add one-off styles in layouts.

    Components: PrimaryPillButton (+ Compact), OutlinePillButton, DarkPillButton, WhitePillButton,
    TextLink, IconCircleButton, StepperButton (Minus / Plus), Chip, Card (+ Large, Tile, Row),
    SelectableCard (+ Service, Soap, Payment) with RadioDot, TextInput, StatusBadge,
    SegmentedControl (view: ui.widget.SegmentedControl), CheckBox, ErrorBanner, WarnNote,
    BottomNavItem.
    Rider: Card.Booking / State / Job / Checklist, PrimaryPill.Small, OutlinePill.Small,
    DarkPill.Small / Large, MapAction, IconCircleButton.OnMap / Accent, PayStrip, PayBox,
    CounterTile; views ui.widget.DutySwitch and ui.widget.StepChecklist.
-->
<resources>

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.LaundryHub.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===== Type scale ===== -->
    <!-- Hero heading: Bricolage Grotesque 800, 32 sp, -0.8 px tracking, 1.05 line height. -->
    <!-- Base text styles extend AppCompat, not Material 3: the M3 type scale sets lineHeight
         (BodyLarge 24 sp, HeadlineLarge 40 sp), which spread multi-line text far beyond the design.
         Line heights are set only where the design sets them (CSS line-height). -->
    <style name="TextAppearance.LaundryHub.Hero" parent="TextAppearance.AppCompat">
        <!-- The 800 file directly: font weights in XML need API 28, minSdk is 24. -->
        <item name="android:fontFamily">@font/bricolage_grotesque_extrabold</item>
        <item name="fontFamily">@font/bricolage_grotesque_extrabold</item>
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Screen title: Bricolage Grotesque 800, 21 sp. -->
    <style name="TextAppearance.LaundryHub.ScreenTitle" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/bricolage_grotesque_extrabold</item>
        <item name="fontFamily">@font/bricolage_grotesque_extrabold</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Section title: DM Sans 700, 17 sp. -->
    <style name="TextAppearance.LaundryHub.SectionTitle" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Body: DM Sans 400, 15 sp. -->
    <style name="TextAppearance.LaundryHub.Body" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Secondary body: DM Sans 400, 14 sp, muted. -->
    <style name="TextAppearance.LaundryHub.BodySmall" parent="TextAppearance.LaundryHub.Body">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Caption: DM Sans 400, 13 sp, muted. -->
    <style name="TextAppearance.LaundryHub.Caption" parent="TextAppearance.LaundryHub.Body">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Form label: DM Sans 700, 13 sp, ink. -->
    <style name="TextAppearance.LaundryHub.Label" parent="TextAppearance.LaundryHub.Body">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Field error under an input (no design): warn text color, caption size. -->
    <style name="TextAppearance.LaundryHub.FieldError" parent="TextAppearance.LaundryHub.Caption">
        <item name="android:textColor">@color/warn_text</item>
    </style>

    <!-- Display heading on Home: Bricolage Grotesque 700, 30 sp, -0.8 px, line height 1.1. -->
    <style name="TextAppearance.LaundryHub.Display" parent="TextAppearance.LaundryHub.Hero">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:letterSpacing">-0.027</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="lineHeight">@dimen/line_display</item>
    </style>

    <!-- Brand name "Laundry HUB": Bricolage Grotesque 800, 22 sp, -0.5 px. -->
    <style name="TextAppearance.LaundryHub.Brand" parent="TextAppearance.LaundryHub.Hero">
        <item name="android:textSize">@dimen/text_brand</item>
        <item name="android:letterSpacing">-0.023</item>
        <item name="android:lineSpacingMultiplier">1</item>
    </style>

    <!-- Wizard step title: Bricolage Grotesque 700, 21 sp, -0.4 px. -->
    <style name="TextAppearance.LaundryHub.StepTitle" parent="TextAppearance.LaundryHub.Display">
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:letterSpacing">-0.019</item>
        <item name="android:lineSpacingMultiplier">1</item>
    </style>

    <!-- Card title on the blue "New order" card: Bricolage Grotesque 700, 22 sp, line height 1.2. -->
    <style name="TextAppearance.LaundryHub.CardTitle" parent="TextAppearance.LaundryHub.Display">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">@dimen/line_card_title</item>
    </style>

    <!-- Big figure in a tile ("30", "8 kg"): Bricolage Grotesque 700, 24 sp. -->
    <style name="TextAppearance.LaundryHub.Figure" parent="TextAppearance.LaundryHub.CardTitle">
        <item name="android:textSize">@dimen/text_figure</item>
        <item name="android:lineSpacingMultiplier">1</item>
    </style>

    <!-- Kilo number on the stepper: Bricolage Grotesque 800, 48 sp, line height 1
         (give the TextView @dimen/kilo_line_height and center gravity). -->
    <style name="TextAppearance.LaundryHub.KiloNumber" parent="TextAppearance.LaundryHub.Hero">
        <item name="android:textSize">@dimen/text_kilo</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1</item>
    </style>

    <!-- Totals: Bricolage Grotesque 800, 22 sp (footer "Estimated total"). -->
    <style name="TextAppearance.LaundryHub.Total" parent="TextAppearance.LaundryHub.KiloNumber">
        <item name="android:textSize">@dimen/text_brand</item>
    </style>

    <!-- Order summary total: 28 sp, accent. -->
    <style name="TextAppearance.LaundryHub.Total.Large">
        <item name="android:textSize">@dimen/text_total_large</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Order placed total: 24 sp, accent. -->
    <style name="TextAppearance.LaundryHub.Total.Medium">
        <item name="android:textSize">@dimen/text_figure</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- "Order placed!": Bricolage Grotesque 800, 28 sp, -0.6 px. -->
    <style name="TextAppearance.LaundryHub.DoneTitle" parent="TextAppearance.LaundryHub.Hero">
        <item name="android:textSize">@dimen/text_total_large</item>
        <item name="android:letterSpacing">-0.021</item>
        <item name="android:lineSpacingMultiplier">1</item>
    </style>

    <!-- Subtitle in cards ("Laundry weight", "Walk-in", "Fabric soap"): DM Sans 700, 16 sp. -->
    <style name="TextAppearance.LaundryHub.Subtitle" parent="TextAppearance.LaundryHub.SectionTitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <!-- Overline ("NEW ORDER"): 13 sp bold, 1 px tracking, upper case. -->
    <style name="TextAppearance.LaundryHub.Overline" parent="TextAppearance.LaundryHub.Label">
        <item name="android:letterSpacing">0.077</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Small text: DM Sans 12 sp, muted. -->
    <style name="TextAppearance.LaundryHub.Small" parent="TextAppearance.LaundryHub.Caption">
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <!-- Accent bold line under a card title ("No extra fee", "+ 5 /kg"). -->
    <style name="TextAppearance.LaundryHub.AccentNote" parent="TextAppearance.LaundryHub.Label">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Body, muted: 15 sp ("Magandang araw!"). -->
    <style name="TextAppearance.LaundryHub.BodyMuted" parent="TextAppearance.LaundryHub.Body">
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Body, compact: 14 sp ink ("How it works" rows, summary values). -->
    <style name="TextAppearance.LaundryHub.BodyCompact" parent="TextAppearance.LaundryHub.Body">
        <item name="android:textSize">@dimen/text_body_small</item>
    </style>

    <!-- Strong: 14 sp bold ink (soap name, chips). -->
    <style name="TextAppearance.LaundryHub.Strong" parent="TextAppearance.LaundryHub.BodyCompact">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Strong, large: 15 sp bold ink (payment method name, "Total"). -->
    <style name="TextAppearance.LaundryHub.StrongLarge" parent="TextAppearance.LaundryHub.Body">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small strong: 12 sp bold ink (map status chip). -->
    <style name="TextAppearance.LaundryHub.SmallStrong" parent="TextAppearance.LaundryHub.Small">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Step number in "How it works": 15 sp bold accent. -->
    <style name="TextAppearance.LaundryHub.StepNumber" parent="TextAppearance.LaundryHub.StrongLarge">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Suffix after a figure (" /kg"): DM Sans 500, 14 sp, muted. -->
    <style name="TextAppearance.LaundryHub.FigureSuffix" parent="TextAppearance.LaundryHub.BodyCompact">
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="fontFamily">@font/dm_sans_medium</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Card description: 13 sp muted with the design's 1.4 line height (DM Sans default is ~1.3). -->
    <style name="TextAppearance.LaundryHub.CardDescription" parent="TextAppearance.LaundryHub.Caption">
        <item name="lineHeight">@dimen/line_card_description</item>
    </style>

    <!-- Soap note: 12 sp muted, line height 1.35. -->
    <style name="TextAppearance.LaundryHub.SmallNote" parent="TextAppearance.LaundryHub.Small">
        <item name="lineHeight">@dimen/line_small_note</item>
    </style>

    <!-- Accent bold, small: 12 sp ("+ 5 /kg", "Included"). -->
    <style name="TextAppearance.LaundryHub.AccentNote.Small">
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <!-- Payment tile letter: 15 sp bold. -->
    <style name="TextAppearance.LaundryHub.Badge" parent="TextAppearance.LaundryHub.StrongLarge" />

    <!-- Default TextView: no extra font padding, so a line is as tall as CSS "normal" line height
         (includeFontPadding is ignored inside a textAppearance, so it lives here). -->
    <style name="Widget.LaundryHub.TextView" parent="android:Widget.TextView">
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== Buttons ===== -->
    <!-- PrimaryPillButton: accent, 54 dp, fully rounded, white 16 sp bold; #9AA5AD when disabled. -->
    <style name="Widget.LaundryHub.Button.PrimaryPill" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LaundryHub.Pill</item>
        <item name="backgroundTint">@color/primary_button_bg</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- OutlinePillButton: white, 1.5 dp #C8D0CA border, 52 dp, ink 15 sp bold (e.g. Continue with Google, Decline). -->
    <style name="Widget.LaundryHub.Button.OutlinePill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_secondary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LaundryHub.Pill</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/input_border</item>
        <item name="strokeWidth">@dimen/stroke_input</item>
        <item name="android:textColor">@color/outline_button_text</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/inline_gap</item>
        <item name="iconSize">@dimen/google_icon</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- PrimaryPillButton, compact: 52 dp, 15 sp, 26 dp side padding (wizard footer Continue / Place order). -->
    <style name="Widget.LaundryHub.Button.PrimaryPill.Compact">
        <item name="android:minHeight">@dimen/button_height_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingStart">@dimen/footer_button_padding</item>
        <item name="android:paddingEnd">@dimen/footer_button_padding</item>
    </style>

    <!-- DarkPillButton: ink, 52 dp, white 15 sp bold (Back to home, Back to bookings). -->
    <style name="Widget.LaundryHub.Button.DarkPill" parent="Widget.LaundryHub.Button.PrimaryPill.Compact">
        <item name="backgroundTint">@color/dark_button_bg</item>
    </style>

    <!-- WhitePillButton: white, 46 dp, ink 15 sp bold, icon after the text ("Start laundry order"). -->
    <style name="Widget.LaundryHub.Button.WhitePill" parent="Widget.LaundryHub.Button.PrimaryPill">
        <item name="android:minHeight">@dimen/white_pill_height</item>
        <item name="android:paddingStart">@dimen/white_pill_padding</item>
        <item name="android:paddingEnd">@dimen/white_pill_padding</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">end</item>
        <item name="iconSize">@dimen/white_pill_icon</item>
        <item name="iconPadding">@dimen/checkbox_gap</item>
        <item name="rippleColor">@color/accent_tint</item>
    </style>

    <!-- IconCircleButton: 44 dp white circle, 1 dp #D5DBD6 border, 20 dp ink icon (Back, bell). -->
    <style name="Widget.LaundryHub.IconCircleButton" parent="">
        <item name="android:layout_width">@dimen/icon_button</item>
        <item name="android:layout_height">@dimen/icon_button</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/ink</item>
    </style>

    <!-- StepperButton: 52 dp circle with a 26 sp bold sign. -->
    <style name="Widget.LaundryHub.Button.Stepper" parent="Widget.LaundryHub.Button.PrimaryPill">
        <item name="android:layout_width">@dimen/stepper_button</item>
        <item name="android:layout_height">@dimen/stepper_button</item>
        <item name="android:minWidth">@dimen/stepper_button</item>
        <item name="android:minHeight">@dimen/stepper_button</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">@dimen/text_stepper</item>
    </style>

    <!-- Minus: white with a 2 dp #D5DBD6 ring; #EEF1EE / #9AA5AD when disabled at the minimum. -->
    <style name="Widget.LaundryHub.Button.Stepper.Minus">
        <item name="backgroundTint">@color/stepper_minus_bg</item>
        <item name="android:textColor">@color/stepper_minus_text</item>
        <item name="strokeColor">@color/icon_button_border</item>
        <item name="strokeWidth">@dimen/stroke_selected</item>
        <item name="rippleColor">@color/accent_tint</item>
    </style>

    <!-- Plus: accent fill, white sign. -->
    <style name="Widget.LaundryHub.Button.Stepper.Plus" />

    <!-- Chip (time slots): 48 dp, 14 dp radius, 2 dp border, 14 sp bold; accent fill + white text when checked. -->
    <style name="Widget.LaundryHub.Button.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:checkable">true</item>
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/inline_gap</item>
        <item name="android:paddingEnd">@dimen/inline_gap</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LaundryHub.Chip</item>
        <item name="backgroundTint">@color/chip_bg</item>
        <item name="strokeColor">@color/chip_stroke</item>
        <item name="strokeWidth">@dimen/stroke_selected</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">1</item>
        <item name="rippleColor">@color/accent_tint</item>
    </style>

    <style name="ShapeAppearance.LaundryHub.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_chip</item>
    </style>

    <!-- TextLink: borderless accent bold text with a 44 dp touch target (Forgot password?, Sign up). -->
    <style name="Widget.LaundryHub.Button.TextLink" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/text_link</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@color/accent_tint</item>
    </style>

    <!-- TextLink at caption size (13 sp), e.g. "Forgot password?". -->
    <style name="Widget.LaundryHub.Button.TextLink.Small">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <!-- ===== Cards ===== -->
    <!-- Card: surface, 18 dp radius, flat. -->
    <style name="Widget.LaundryHub.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- SelectableCard: 2 dp border (#DCE2DD → accent) and #F2F7FC fill when checked. Use setChecked(). -->
    <style name="Widget.LaundryHub.SelectableCard" parent="Widget.LaundryHub.Card">
        <item name="android:checkable">true</item>
        <item name="cardBackgroundColor">@color/selectable_card_bg</item>
        <item name="strokeColor">@color/selectable_card_stroke</item>
        <item name="strokeWidth">@dimen/stroke_selected</item>
        <item name="checkedIcon">@null</item>
        <!-- No Material checked overlay: the design only changes border and fill. -->
        <item name="cardForegroundColor">@android:color/transparent</item>
        <item name="rippleColor">@color/accent_tint</item>
        <!-- CSS padding is inside the 2 px border; MaterialCardView draws the stroke over the padding. -->
        <item name="contentPadding">@dimen/selectable_card_padding</item>
    </style>

    <!-- Card.Hero: accent, 24 dp radius, no padding (Home "New order" card; content pads itself). -->
    <style name="Widget.LaundryHub.Card.Hero">
        <item name="cardCornerRadius">@dimen/radius_hero</item>
        <item name="cardBackgroundColor">@color/accent</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- Card.Large: 20 dp radius, 18 dp padding (weight card, order summary, shop card). -->
    <style name="Widget.LaundryHub.Card.Large">
        <item name="cardCornerRadius">@dimen/radius_card_large</item>
    </style>

    <!-- Card.Tile: 18 dp radius, 16 dp padding (Home price tile). -->
    <style name="Widget.LaundryHub.Card.Tile">
        <item name="contentPadding">@dimen/tile_padding</item>
    </style>

    <!-- Card.Row: 16 dp radius, 14 dp padding ("How it works" rows). -->
    <style name="Widget.LaundryHub.Card.Row">
        <item name="cardCornerRadius">@dimen/row_card_radius</item>
        <item name="contentPadding">@dimen/row_card_padding</item>
    </style>

    <!-- SelectableCard.Service: 20 dp radius, 18 dp padding (02 service cards). -->
    <style name="Widget.LaundryHub.SelectableCard.Service">
        <item name="cardCornerRadius">@dimen/radius_card_large</item>
    </style>

    <!-- SelectableCard.Soap: 18 dp radius, 14 dp padding, at least 120 dp tall (03 soap grid). -->
    <style name="Widget.LaundryHub.SelectableCard.Soap">
        <item name="contentPadding">@dimen/soap_card_padding_inner</item>
        <item name="android:minHeight">@dimen/soap_card_min_height</item>
    </style>

    <!-- SelectableCard.Payment: 18 dp radius, 14 / 16 dp padding, at least 64 dp tall (05). -->
    <style name="Widget.LaundryHub.SelectableCard.Payment">
        <item name="contentPaddingTop">@dimen/payment_card_padding_v_inner</item>
        <item name="contentPaddingBottom">@dimen/payment_card_padding_v_inner</item>
        <item name="contentPaddingLeft">@dimen/payment_card_padding_h_inner</item>
        <item name="contentPaddingRight">@dimen/payment_card_padding_h_inner</item>
        <item name="android:minHeight">@dimen/payment_card_min_height</item>
    </style>

    <!-- RadioDot inside a SelectableCard (24 dp; follows the card checked state). -->
    <style name="Widget.LaundryHub.RadioDot" parent="">
        <item name="android:layout_width">@dimen/radio_dot</item>
        <item name="android:layout_height">@dimen/radio_dot</item>
        <item name="android:background">@drawable/bg_radio_dot</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- RadioDot on payment cards: 22 dp. -->
    <style name="Widget.LaundryHub.RadioDot.Small">
        <item name="android:layout_width">@dimen/radio_dot_small</item>
        <item name="android:layout_height">@dimen/radio_dot_small</item>
        <item name="android:background">@drawable/bg_radio_dot_small</item>
    </style>

    <!-- ===== Inputs ===== -->
    <!-- TextInput: white, 50 dp, 14 dp radius, 1.5 dp #C8D0CA border, 15 sp. -->
    <style name="Widget.LaundryHub.TextInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_text_input</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">@dimen/input_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/input_padding_horizontal</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/subtle</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:maxLines">1</item>
        <item name="android:importantForAutofill">yes</item>
    </style>

    <!-- CheckBox: 13 sp muted label, accent when ticked. -->
    <style name="Widget.LaundryHub.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/checkbox_tint</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <!-- The Material check box is inset inside its drawable; this puts the box on the
             26 dp content edge like the design. -->
        <item name="android:layout_marginStart">@dimen/checkbox_inset_correction</item>
    </style>

    <!-- ===== Badges, segmented control, banners ===== -->
    <!-- StatusBadge: 12 sp bold, 5×10 dp padding, 10 dp radius. Colors per status: StatusBadge.apply(). -->
    <style name="Widget.LaundryHub.StatusBadge" parent="">
        <item name="android:background">@drawable/bg_status_badge</item>
        <item name="android:paddingStart">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/badge_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/badge_padding_vertical</item>
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- SegmentedControl track: #E3E8E4, 16 dp radius, 5 dp padding. -->
    <style name="Widget.LaundryHub.SegmentedControl" parent="">
        <item name="android:background">@drawable/bg_segmented_track</item>
        <item name="android:padding">@dimen/segmented_padding</item>
    </style>

    <!-- One segment: 44 dp, 14 sp bold; white pill + ink when selected, muted otherwise. -->
    <style name="Widget.LaundryHub.SegmentedControl.Segment" parent="">
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:minHeight">@dimen/segment_height</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- WarnNote: warn colors, 12 dp radius, 10 / 12 dp padding, 13 sp ("Minimum of 8 kg per order..."). -->
    <style name="Widget.LaundryHub.WarnNote" parent="">
        <item name="android:background">@drawable/bg_warn_note</item>
        <item name="android:paddingStart">@dimen/warn_note_padding_h</item>
        <item name="android:paddingEnd">@dimen/warn_note_padding_h</item>
        <item name="android:paddingTop">@dimen/warn_note_padding_v</item>
        <item name="android:paddingBottom">@dimen/warn_note_padding_v</item>
        <item name="android:drawablePadding">@dimen/checkbox_gap</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/warn_text</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <!-- BottomNavItem: at least 64 x 48 dp, 22 dp icon over a 12 sp label; accent when selected. -->
    <style name="Widget.LaundryHub.BottomNavItem" parent="">
        <item name="android:minWidth">@dimen/nav_item_min_width</item>
        <item name="android:minHeight">@dimen/nav_item_min_height</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:drawablePadding">@dimen/nav_gap</item>
        <item name="android:textColor">@color/nav_item</item>
        <item name="drawableTint">@color/nav_item</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ErrorBanner (no design for errors): warn colors, 14 dp radius. -->
    <style name="Widget.LaundryHub.ErrorBanner" parent="">
        <item name="android:background">@drawable/bg_error_banner</item>
        <item name="android:padding">@dimen/input_padding_horizontal</item>
        <item name="android:textColor">@color/warn_text</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <!-- ===== Rider app (source/Rider.dc.html) ===== -->
    <!-- "Hi, [RIDER NAME]": Bricolage Grotesque 800, 24 sp, white. -->
    <style name="TextAppearance.LaundryHub.Greeting" parent="TextAppearance.LaundryHub.Hero">
        <item name="android:textSize">@dimen/text_greeting</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="android:textColor">@color/surface</item>
    </style>

    <!-- 13 sp on the dark header ("Laundry HUB Rider"). -->
    <style name="TextAppearance.LaundryHub.OnDarkCaption" parent="TextAppearance.LaundryHub.Caption">
        <item name="android:textColor">@color/on_dark_muted</item>
    </style>

    <!-- Counter label: 11 sp #B8C3CC. -->
    <style name="TextAppearance.LaundryHub.CounterLabel" parent="TextAppearance.LaundryHub.OnDarkCaption">
        <item name="android:textSize">@dimen/text_counter_label</item>
    </style>

    <!-- Counter number: Bricolage Grotesque 800, 22 sp, white. -->
    <style name="TextAppearance.LaundryHub.CounterNumber" parent="TextAppearance.LaundryHub.Total">
        <item name="android:textColor">@color/surface</item>
    </style>

    <!-- Duty switch label: 13 sp bold white. -->
    <style name="TextAppearance.LaundryHub.DutyLabel" parent="TextAppearance.LaundryHub.Label">
        <item name="android:textColor">@color/surface</item>
    </style>

    <!-- Customer initials: 16 sp bold accent. -->
    <style name="TextAppearance.LaundryHub.Initials" parent="TextAppearance.LaundryHub.Subtitle">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Checklist step: DM Sans 500, 14 sp (StepChecklist sets weight and color per state). -->
    <style name="TextAppearance.LaundryHub.StepLabel" parent="TextAppearance.LaundryHub.BodyCompact">
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="fontFamily">@font/dm_sans_medium</item>
    </style>

    <!-- Current checklist step: DM Sans 700. -->
    <style name="TextAppearance.LaundryHub.StepLabel.Current">
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
    </style>

    <!-- Job payment amount: Bricolage Grotesque 800, 20 sp (color per job). -->
    <style name="TextAppearance.LaundryHub.PayAmount" parent="TextAppearance.LaundryHub.Total">
        <item name="android:textSize">@dimen/text_pay_amount</item>
    </style>

    <!-- Card.Booking: 20 dp radius, 16 dp padding (R1 booking cards). -->
    <style name="Widget.LaundryHub.Card.Booking">
        <item name="cardCornerRadius">@dimen/radius_card_large</item>
        <item name="contentPadding">@dimen/booking_padding</item>
    </style>

    <!-- Card.State: 20 dp radius, 26 / 20 dp padding (R5 off duty, empty lists). -->
    <style name="Widget.LaundryHub.Card.State">
        <item name="cardCornerRadius">@dimen/radius_card_large</item>
        <item name="contentPaddingTop">@dimen/state_card_padding_v</item>
        <item name="contentPaddingBottom">@dimen/state_card_padding_v</item>
        <item name="contentPaddingLeft">@dimen/state_card_padding_h</item>
        <item name="contentPaddingRight">@dimen/state_card_padding_h</item>
    </style>

    <!-- Card.Job: 18 dp radius, 14 dp padding (active job customer card). -->
    <style name="Widget.LaundryHub.Card.Job">
        <item name="contentPadding">@dimen/row_card_padding</item>
    </style>

    <!-- Card.Checklist: 18 dp radius, 16 dp padding (active job steps, job completed row). -->
    <style name="Widget.LaundryHub.Card.Checklist">
        <item name="contentPadding">@dimen/booking_padding</item>
    </style>

    <!-- Small pills on booking cards: 48 dp, 14 sp bold. -->
    <style name="Widget.LaundryHub.Button.PrimaryPill.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:paddingStart">@dimen/inline_gap</item>
        <item name="android:paddingEnd">@dimen/inline_gap</item>
    </style>

    <!-- "Decline": white, 1.5 dp #C8D0CA border, 48 dp, 14 sp bold. -->
    <style name="Widget.LaundryHub.Button.OutlinePill.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textSize">@dimen/text_body_small</item>
    </style>

    <!-- "Start job" / "Continue job": ink, 48 dp, 14 sp bold. -->
    <style name="Widget.LaundryHub.Button.DarkPill.Small" parent="Widget.LaundryHub.Button.PrimaryPill.Small">
        <item name="backgroundTint">@color/dark_button_bg</item>
    </style>

    <!-- "Back to bookings": ink, 54 dp, 16 sp bold. -->
    <style name="Widget.LaundryHub.Button.DarkPill.Large" parent="Widget.LaundryHub.Button.PrimaryPill">
        <item name="backgroundTint">@color/dark_button_bg</item>
    </style>

    <!-- "Navigate in Google Maps": ink, 44 dp, 13 sp bold, 16 dp arrow 8 dp before the text. -->
    <style name="Widget.LaundryHub.Button.MapAction" parent="Widget.LaundryHub.Button.PrimaryPill">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:paddingStart">@dimen/navigate_padding_h</item>
        <item name="android:paddingEnd">@dimen/navigate_padding_h</item>
        <item name="backgroundTint">@color/dark_button_bg</item>
        <item name="icon">@drawable/ic_navigation</item>
        <item name="iconTint">@color/surface</item>
        <item name="iconSize">@dimen/navigate_icon</item>
        <item name="iconPadding">@dimen/navigate_gap</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Round button on a map (Back): 44 dp white circle without a border. -->
    <style name="Widget.LaundryHub.IconCircleButton.OnMap">
        <item name="android:background">@drawable/bg_map_button</item>
    </style>

    <!-- Call button: 44 dp accent circle with a white 18 dp phone. -->
    <style name="Widget.LaundryHub.IconCircleButton.Accent">
        <item name="android:background">@drawable/bg_call_button</item>
        <item name="tint">@color/surface</item>
    </style>

    <!-- Payment strip on booking cards: #F3F5F2, 12 dp radius, 10 / 12 dp padding, 13 sp. -->
    <style name="Widget.LaundryHub.PayStrip" parent="">
        <item name="android:background">@drawable/bg_pay_strip</item>
        <item name="android:paddingStart">@dimen/pay_strip_padding_h</item>
        <item name="android:paddingEnd">@dimen/pay_strip_padding_h</item>
