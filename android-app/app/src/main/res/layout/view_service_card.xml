<?xml version="1.0" encoding="utf-8"?>
<!-- Service card (02): SelectableCard.Service, 48 dp icon tile, name / description / fee, radio dot. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.LaundryHub.SelectableCard.Service"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/icon_tile"
            android:layout_height="@dimen/icon_tile"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/icon_tile_icon"
                android:layout_height="@dimen/icon_tile_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/new_order_gap"
            android:layout_marginEnd="@dimen/new_order_gap"
            android:layout_weight="1"
            android:divider="@drawable/space_4"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LaundryHub.Subtitle" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LaundryHub.CardDescription" />

            <TextView
                android:id="@+id/fee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LaundryHub.AccentNote" />
        </LinearLayout>

        <View style="@style/Widget.LaundryHub.RadioDot" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
