<?xml version="1.0" encoding="utf-8"?>
<!-- One chat bubble; ChatAdapter aligns it right (own, accent) or left (shop, white with the sender). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="@dimen/chat_gap">

    <TextView
        android:id="@+id/sender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/payment_text_gap"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.LaundryHub.Small" />

    <TextView
        android:id="@+id/body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:maxWidth="@dimen/chat_bubble_max"
        android:paddingStart="@dimen/chat_bubble_padding_h"
        android:paddingTop="@dimen/chat_bubble_padding_v"
        android:paddingEnd="@dimen/chat_bubble_padding_h"
        android:paddingBottom="@dimen/chat_bubble_padding_v"
        android:textAppearance="@style/TextAppearance.LaundryHub.BodyCompact" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/payment_text_gap"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.LaundryHub.Small" />
</LinearLayout>
