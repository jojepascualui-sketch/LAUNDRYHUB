<?xml version="1.0" encoding="utf-8"?>
<!--
    06-order-placed: check circle, "Order placed!", "Order #… · service", summary card, spacer,
    dark "Back to home". Padding 60 / 26 / 30, 22 dp between blocks.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:divider="@drawable/space_22"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/auth_side_padding"
    android:paddingTop="@dimen/done_padding_top"
    android:paddingEnd="@dimen/auth_side_padding"
    android:paddingBottom="@dimen/done_padding_bottom"
    android:showDividers="middle">

    <FrameLayout
        android:layout_width="@dimen/done_circle"
        android:layout_height="@dimen/done_circle"
        android:background="@drawable/bg_done_circle">

        <ImageView
            android:layout_width="@dimen/done_icon"
            android:layout_height="@dimen/done_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/order_placed"
            android:textAppearance="@style/TextAppearance.LaundryHub.DoneTitle" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/done_sub_gap"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.LaundryHub.BodySmall" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.LaundryHub.Card.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/space_10"
            android:orientation="vertical"
            android:showDividers="middle">

            <include
                android:id="@+id/row_weight"
                layout="@layout/item_summary_row" />

            <include
                android:id="@+id/row_soap"
                layout="@layout/item_summary_row" />

            <include
                android:id="@+id/row_schedule"
                layout="@layout/item_summary_row" />

            <include
                android:id="@+id/row_payment"
                layout="@layout/item_summary_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:background="@color/divider" />

            <include
                android:id="@+id/row_total"
                layout="@layout/item_total_row" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/back_home"
        style="@style/Widget.LaundryHub.Button.DarkPill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_home" />
</LinearLayout>
