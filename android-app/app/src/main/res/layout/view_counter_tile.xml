<?xml version="1.0" encoding="utf-8"?>
<!-- Rider header counter: 11 sp label over a 22 sp Bricolage number. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.LaundryHub.CounterTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:screenReaderFocusable="true">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.LaundryHub.CounterLabel" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.LaundryHub.CounterNumber" />
</LinearLayout>
