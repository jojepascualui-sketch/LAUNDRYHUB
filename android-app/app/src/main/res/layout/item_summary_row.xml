<?xml version="1.0" encoding="utf-8"?>
<!-- Summary row (05, 06): 14 sp muted label, 14 sp value at the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.LaundryHub.BodySmall" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_gap"
        android:textAppearance="@style/TextAppearance.LaundryHub.BodyCompact" />
</LinearLayout>
