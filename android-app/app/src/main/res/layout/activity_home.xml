<?xml version="1.0" encoding="utf-8"?>
<!--
    01-home (source/Main.dc.html, HOME): brand row with bell, greeting + hero, blue "New order" card,
    price and minimum-load tiles, "How it works", bottom nav. Padding 28 / 22 / 16, 22 dp between sections.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/space_22"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/home_padding_top"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/home_padding_bottom"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/brand_tile"
                    android:layout_height="@dimen/brand_tile"
                    android:background="@drawable/bg_brand_tile">

                    <ImageView
                        android:layout_width="@dimen/brand_icon"
                        android:layout_height="@dimen/brand_icon"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_logo_washer_white" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/inline_gap"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.LaundryHub.Brand" />

                <ImageButton
                    android:id="@+id/bell"
                    style="@style/Widget.LaundryHub.IconCircleButton"
                    android:contentDescription="@string/notifications"
                    android:src="@drawable/ic_bell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/greeting"
                    android:textAppearance="@style/TextAppearance.LaundryHub.BodyMuted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/display_gap"
                    android:text="@string/home_hero"
                    android:textAppearance="@style/TextAppearance.LaundryHub.Display" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LaundryHub.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_new_order_rings"
                    android:divider="@drawable/space_14"
                    android:orientation="vertical"
                    android:padding="@dimen/new_order_padding"
                    android:showDividers="middle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/new_order"
                        android:textAppearance="@style/TextAppearance.LaundryHub.Overline"
                        android:textColor="@color/surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/new_order_title"
                        android:textAppearance="@style/TextAppearance.LaundryHub.CardTitle"
                        android:textColor="@color/surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/start_order"
                        style="@style/Widget.LaundryHub.Button.WhitePill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/start_laundry_order"
                        app:icon="@drawable/ic_arrow_right" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.LaundryHub.Card.Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/tile_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/space_6"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wash_dry_fold"
                            android:textAppearance="@style/TextAppearance.LaundryHub.Caption" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.LaundryHub.Figure" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/per_kg_suffix"
                                android:textAppearance="@style/TextAppearance.LaundryHub.FigureSuffix" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/tile_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_warn_tile"
                    android:divider="@drawable/space_6"
                    android:orientation="vertical"
                    android:padding="@dimen/tile_padding"
                    android:showDividers="middle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/minimum_load"
                        android:textAppearance="@style/TextAppearance.LaundryHub.Caption"
                        android:textColor="@color/warn_text" />

                    <TextView
                        android:id="@+id/minimum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LaundryHub.Figure"
                        android:textColor="@color/warn_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/space_12"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/how_it_works"
                    android:textAppearance="@style/TextAppearance.LaundryHub.SectionTitle" />

                <include
                    android:id="@+id/how_1"
                    layout="@layout/view_how_step" />

                <include
                    android:id="@+id/how_2"
                    layout="@layout/view_how_step" />

                <include
                    android:id="@+id/how_3"
                    layout="@layout/view_how_step" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/nav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
