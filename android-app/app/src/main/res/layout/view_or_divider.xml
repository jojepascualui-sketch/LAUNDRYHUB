<?xml version="1.0" encoding="utf-8"?>
<!-- "or" between two 1 dp #D5DBD6 lines, 12 dp gaps, 13 sp muted (source/Auth.dc.html). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline"
        android:layout_weight="1"
        android:background="@color/or_divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/or_gap"
        android:layout_marginEnd="@dimen/or_gap"
        android:text="@string/or"
        android:textAppearance="@style/TextAppearance.LaundryHub.Caption" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline"
        android:layout_weight="1"
        android:background="@color/or_divider" />
</LinearLayout>
