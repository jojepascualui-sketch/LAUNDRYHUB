<?xml version="1.0" encoding="utf-8"?>
<!--
    R1-rider-bookings / R5-rider-off-duty: dark header (greeting, duty switch, three counters),
    Available / My jobs tabs, then booking cards (or the off-duty / empty card) with pull-to-refresh.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ink"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/rider_header_padding_top"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/rider_header_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rider_brand"
                    android:textAppearance="@style/TextAppearance.LaundryHub.OnDarkCaption" />

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.LaundryHub.Greeting" />
            </LinearLayout>

            <com.laundryhub.app.ui.widget.DutySwitch
                android:id="@+id/duty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rider_counters_gap"
            android:divider="@drawable/space_8"
            android:orientation="horizontal"
            android:showDividers="middle">

            <include
                android:id="@+id/count_available"
                layout="@layout/view_counter_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/count_accepted"
                layout="@layout/view_counter_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/count_done"
                layout="@layout/view_counter_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <com.laundryhub.app.ui.widget.SegmentedControl
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/rider_tabs_padding_top"
        android:layout_marginEnd="@dimen/screen_padding" />

    <TextView
        android:id="@+id/banner"
        style="@style/Widget.LaundryHub.ErrorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/rider_list_padding_top"
        android:layout_marginEnd="@dimen/screen_padding"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/rider_list_padding_top"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/chat_button_clearance" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Feedback chat (no design, CLAUDE.md §7): accent round button over the list, so the designed
         header stays as in R1/R5. -->
    <ImageButton
        android:id="@+id/chat"
        style="@style/Widget.LaundryHub.IconCircleButton.Accent"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:contentDescription="@string/chat_title"
        android:src="@drawable/ic_chat" />
    </FrameLayout>
</LinearLayout>
