<?xml version="1.0" encoding="utf-8"?>
<!-- Step 4 · 05-review-and-pay: order summary, payment cards, GCash number. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/step_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/space_16"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/wizard_content_padding_top"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/wizard_content_padding_bottom"
        android:showDividers="middle">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LaundryHub.Card.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/space_12"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/order_summary"
                    android:textAppearance="@style/TextAppearance.LaundryHub.Subtitle" />

                <include
                    android:id="@+id/row_service"
                    layout="@layout/item_summary_row" />

                <include
                    android:id="@+id/row_laundry"
                    layout="@layout/item_summary_row" />

                <include
                    android:id="@+id/row_soap"
                    layout="@layout/item_summary_row" />

                <include
                    android:id="@+id/row_fee"
                    layout="@layout/item_summary_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_total"
                    layout="@layout/item_total_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/space_10"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/payment_method"
                android:textAppearance="@style/TextAppearance.LaundryHub.Subtitle" />

            <include
                android:id="@+id/cash"
                layout="@layout/view_payment_card" />

            <include
                android:id="@+id/gcash"
                layout="@layout/view_payment_card" />

            <com.laundryhub.app.ui.widget.FormField
                android:id="@+id/gcash_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phoneNumber"
                android:hint="@string/hint_mobile"
                android:imeOptions="actionDone"
                android:inputType="phone"
                app:compact="true"
                app:label="@string/label_gcash_number" />
        </LinearLayout>

        <TextView
            android:id="@+id/error_banner"
            style="@style/Widget.LaundryHub.ErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
