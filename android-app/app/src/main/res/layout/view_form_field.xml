<?xml version="1.0" encoding="utf-8"?>
<!-- Children of ui.widget.FormField: label (13 sp bold), 6 dp gap, TextInput, error line. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/form_field_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.LaundryHub.Label" />

    <EditText
        android:id="@+id/form_field_input"
        style="@style/Widget.LaundryHub.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/label_gap" />

    <TextView
        android:id="@+id/form_field_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/label_gap"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.LaundryHub.FieldError"
        android:visibility="gone" />
</merge>
