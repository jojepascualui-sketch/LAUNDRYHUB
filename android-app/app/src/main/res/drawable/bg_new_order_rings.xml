<?xml version="1.0" encoding="utf-8"?>
<!-- Rings on the "New order" card: top-end, offset -40 / -40, never affects layout. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="@dimen/card_ring_size"
        android:height="@dimen/card_ring_size"
        android:drawable="@drawable/art_card_rings"
        android:end="@dimen/card_ring_offset"
        android:gravity="top|end"
        android:top="@dimen/card_ring_offset" />
</layer-list>
